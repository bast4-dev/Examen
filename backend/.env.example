NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/exam1Db
# Secret de signature des JWT (64 caractères aléatoires : openssl rand -hex 32)
JWT_SECRET=a_remplacer
# URL(s) du frontend autorisée(s) par CORS, séparées par des virgules
FRONTEND_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8000
# Clé partagée backend <-> gateway <-> microservices (openssl rand -hex 32)
INTERNAL_API_KEY=a_remplacer
ADMIN_EMAIL=admin@example.com
# Optionnel : domaine du cookie en production (ex. .mondomaine.fr), nombre de proxys de confiance
# COOKIE_DOMAIN=
# TRUST_PROXY=1
# LOG_LEVEL=info
