# Fichier .env à la racine : utilisé par `npm run start:all` ET par `docker compose`
# Copier en .env et remplacer les valeurs (openssl rand -hex 32 pour les secrets)
JWT_SECRET=a_remplacer
INTERNAL_API_KEY=a_remplacer
# Serveur SMTP (vide = Gmail). Ex. de test : smtp.ethereal.email / 587
SMTP_HOST=
SMTP_PORT=
EMAIL_USER=compte@gmail.com
EMAIL_APPLICATION_PASSWORD=a_remplacer
ADMIN_EMAIL=admin@example.com

# Docker uniquement : URL publiques (domaine en production)
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
# FRONT_PORT=3000
# API_PORT=5000
# MONGO_PORT=27018
# COOKIE_DOMAIN=.mondomaine.fr
# TRUST_PROXY=1

# Exécution locale sans Docker (npm run start:all)
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/exam1Db
GATEWAY_URL=http://localhost:8000
GATEWAY_PORT=8000
NOTIFI_SERVICE_URL=http://localhost:4002
STOCK_SERVICE_URL=http://localhost:4003
NOTIFI_PORT=4002
STOCK_PORT=4003
